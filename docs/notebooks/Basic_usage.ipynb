            adata = anndata.read_h5ad(input_dir)
            adata = adata[adata.obs["Section ID"]==slice_name].copy()
        else:
            input_dir = "/maiziezhou_lab/Datasets/ST_datasets/SNI_merged_0917"
            adata = anndata.read_h5ad(osp.join(input_dir, slice_name+"_Tangram_impute.h5ad"))
        adata.obsm["spatial"] = adata.obs[["center_x", "center_y"]].to_numpy()
    elif data_name == "spatialZ_painControl":
        if "Sham" in slice_name:
            dst = "/maiziezhou_lab3/manfeifei/0Projects/localOT/COMMOT/spatialZ/Sham_interpolated_9slices_alignedXY.h5ad"
        else:
            dst = "/maiziezhou_lab3/manfeifei/0Projects/localOT/COMMOT/spatialZ/SNI_interpolated_9slices_alignedXY.h5ad"
        adata = sc.read_h5ad(dst)
        # Unique slice IDs in their order of appearance
        slice_ids = adata.obs["slice_id"].unique()

        # z-coordinate for each slice
        z_values = np.arange(0, 251, 25)

        assert len(slice_ids) == len(z_values), \
            f"Expected 11 slices, found {len(slice_ids)}"

        # Map slice_id -> z
        slice_to_z = dict(zip(slice_ids, z_values))

        # Get z value for every spot
        z = adata.obs["slice_id"].map(slice_to_z).to_numpy()

        # Assuming spatial currently contains [x, y]
        xy = adata.obsm["spatial"][:, :2]

        # Create [x, y, z]
        adata.obsm["spatial"] = np.column_stack([xy, z])
    elif data_name == "SNI_L": 
        if impute == "No":
            input_dir = "/maiziezhou_lab/Datasets/ST_datasets/SNI_merged_0917/SNI_merged_0917.h5ad"
            adata = anndata.read_h5ad(input_dir)
            adata = adata[adata.obs["Section ID"]==slice_name].copy()
        else:
            input_dir = "/maiziezhou_lab/Datasets/ST_datasets/SNI_merged_0917"
            adata = anndata.read_h5ad(osp.join(input_dir, slice_name+"_Tangram_impute.h5ad"))
        adata.obsm["spatial"] = adata.obs[["center_x", "center_y"]].to_numpy()
    elif data_name == "DLPFC":
        section_file = "/maiziezhou_lab/Datasets/ST_datasets/DLPFC12"
        adata = st_loading_utils.load_DLPFC(root_dir=section_file, section_id=slice_name)
        adata.obs['Ground Truth'] = adata.obs['original_clusters'].astype('category')
    elif data_name == "BRCA_5":
        section_file = "/maiziezhou_lab4/Datasets/ST_datasets/BRCA_Human_3Ddataset_5/BRCA_Human_3Ddataset_5.h5ad"
        adata = anndata.read_h5ad(section_file) 
        adata.obs["slice"] = adata.obs_names.str.split("-").str[-1]
        adata=adata[adata.obs["slice"] == 'slice'+slice_name]
    elif data_name == "BRCA_5_3D_So3D":
        section_file = "/maiziezhou_lab4/Datasets/ST_datasets/BRCA_Human_3Ddataset_5/BRCA_Human_3Ddataset_5.h5ad"
        adata = anndata.read_h5ad(section_file) 
        sp = adata.obsm["spatial"].copy()
        mapping = {0.0: 0.0, 19.84: 100.0, 39.68: 200.0, 59.52: 300.0}
        col3 = sp[:, 2]
        sp[:, 2] = np.vectorize(mapping.get)(col3)
        adata.obsm["spatial"] = sp
    elif data_name in ("BRCA_5_3D", "BRCA_5_3D_GT"):
        section_ids = ["0", "1", "2", "3"]
        if data_name == "BRCA_5_3D":
            coord_path = "/maiziezhou_lab/manfeifei/0Projects/localOT/BRCA_5_CT/1/threeD/aligned_spatial.csv"
        else:
            coord_path = "/maiziezhou_lab/manfeifei/0Projects/localOT/BRCA_5_GT/1/threeD/aligned_spatial.csv"

        z_map = {
            "0": 0,
            "1": 100,
            "2": 200,
            "3": 300,
        }
        # -------------------------
        # Load aligned coordinate file
        # -------------------------
        coord_df = pd.read_csv(coord_path)

        # cell_name example: AAACAAGTATCTCCCA-1_151673
        coord_df["slice"] = coord_df["cell_name"].str.rsplit("_", n=1).str[1]
        coord_df["spot_name"] = coord_df["cell_name"].str.rsplit("_", n=1).str[0]

        adata_list = []

        # -------------------------
        # Load each slice and match spots slice-by-slice
        # -------------------------
        section_file = "/maiziezhou_lab4/Datasets/ST_datasets/BRCA_Human_3Ddataset_5/BRCA_Human_3Ddataset_5.h5ad"
        adata4 = anndata.read_h5ad(section_file) 
        adata4.obs["slice"] = adata4.obs_names.str.split("-").str[-1]
        
        for section_id in section_ids:
            print(f"\nProcessing slice {section_id}")
            adata=adata4[adata4.obs["slice"] == 'slice'+section_id]
            adata.obs["slice"] = section_id

            # Coordinates for this slice only
            coord_sub = coord_df[coord_df["slice"] == section_id].copy()
            coord_sub = coord_sub.set_index("spot_name")

            # Match spots within this slice
            common_spots = adata.obs_names.intersection(coord_sub.index)
            print(f"Matched spots: {len(common_spots)} / {adata.n_obs}")

            # Keep only matched spots
            adata = adata[common_spots].copy()
            # Reorder coord_sub to exactly match adata.obs_names
            coord_sub = coord_sub.loc[adata.obs_names].copy()
            # Replace Z with fixed slice-specific value
            coord_sub["Z"] = z_map[section_id]
            # Add aligned 3D coordinates to obsm
            adata.obsm["spatial"] = coord_sub[["X", "Y", "Z"]].to_numpy()
            adata.obsm["spatial_3D_aligned"] = coord_sub[["X", "Y", "Z"]].to_numpy()
            # Optional: save coordinates and labels in obs
            adata.obs["aligned_X"] = coord_sub["X"].values
            adata.obs["aligned_Y"] = coord_sub["Y"].values
            adata.obs["aligned_Z"] = coord_sub["Z"].values
            adata.obs["gt_labels_from_alignment"] = coord_sub["gt_labels"].astype(str).values
            # adata.obs["celltype_colors"] = coord_sub["celltype_colors"].values
            adata_list.append(adata)
        # -------------------------
        # Concatenate all slices
        # -------------------------
        adata_all = concat(
            adata_list,
            axis=0,
            join="outer",
            label="batch",
            keys=section_ids,
            index_unique="_"
        )

        # -------------------------
        # Sanity checks
        # -------------------------
        print("\nFinal concatenated AnnData:")
        print(adata_all)

        print("\nSpatial shape:")
        print(adata_all.obsm["spatial"].shape)

        print("\nZ values by slice:")
        for section_id in section_ids:
            z_vals = np.unique(
                adata_all.obs.loc[adata_all.obs["slice"] == section_id, "aligned_Z"]
            )
            print(section_id, z_vals)

        print("\nFirst 5 spatial coordinates:")
        print(adata_all.obsm["spatial"][:5])
        adata = adata_all.copy()
    elif data_name == "MERFISH_mouse_spinalcord":
