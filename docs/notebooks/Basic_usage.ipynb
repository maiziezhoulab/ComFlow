        print("duplicated genes:", len(dup))
        adata.var_names_make_unique()

        ct_file = os.path.join(ct_path, f"{slice_name}.csv")
        ct_df = pd.read_csv(ct_file)

        ct_df["pixel"] = ct_df["pixel"].astype(str)

        ct_map = dict(zip(ct_df["pixel"], ct_df["cell_type"]))
        adata.obs["cell_type"] = adata.obs_names.map(ct_map)

        print(f"Matched spots   : {adata.obs['cell_type'].notna().sum()} / {adata.n_obs}")
        print(f"Unknown spots   : {adata.obs['cell_type'].isna().sum()}")

        adata.obs["cell_type"] = adata.obs["cell_type"].fillna("Unknown")
        adata.obs["cell_type"] = adata.obs["cell_type"].replace(
            ["nan", "NaN", "NA", "None", ""],
            "Unknown"
        )
        # adata.obs["cell_type"] = adata.obs["cell_type"].astype(str)
        adata.obs["cell_type"] = adata.obs["cell_type"].astype("category")
        CNV_dir = "/maiziezhou_lab/manfeifei/0Projects/localOT/COMMOT/copyKAT"
        if "tumor" not in adata.obs["cell_type"].cat.categories:
            adata.obs["cell_type"] = adata.obs["cell_type"].cat.add_categories(["tumor"])
        cnv_path = os.path.join(CNV_dir, "NCCE_"+slice_name, "prediction_aligned.txt")
        cnv = pd.read_csv(cnv_path, sep="\t", comment="#")

        # build mapping: cell.names -> copykat.pred
        cnv["cell.names"] = cnv["cell.names"].astype(str)
        cnv_map = cnv.set_index("cell.names")["copykat.pred"].to_dict()

        # attach CopyKAT prediction to adata
        adata.obs["copykat_pred"] = adata.obs_names.astype(str).map(cnv_map)

        print("CopyKAT matched:", adata.obs["copykat_pred"].notna().sum(), "/", adata.n_obs)

        # change epithelial -> tumor if copykat_pred == aneuploid
        mask = (adata.obs["cell_type"] == "epithelial") & (adata.obs["copykat_pred"] == "aneuploid")
        print("Epithelial->tumor:", mask.sum())

        adata.obs.loc[mask, "cell_type"] = "tumor"
        adata.obs["cell_type"] = adata.obs["cell_type"].astype("category")

    elif data_name == "DLPFC_3D":
        section_file = "/maiziezhou_lab/Datasets/ST_datasets/DLPFC12"
        section_ids = ["151673", "151674", "151675", "151676"]
        coord_path = "/maiziezhou_lab/manfeifei/0Projects/localOT/for_DLPFC_realData/3D/spacel_Clu_Vclu_dis_staAll_0105_26/1/151673_151676/localOT_DLPFC_151673_151676_aligned_coordinates_colors.csv"

