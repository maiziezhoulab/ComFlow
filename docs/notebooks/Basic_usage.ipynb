            ["nan", "NaN", "NA", "None", ""],
            "Unknown"
        )
        adata.obs["cell_type"] = adata.obs["cell_type"].astype(str)
    elif data_name == "GC_CNV":
        datapath = "/maiziezhou_lab4/Datasets/HwangLab_Data/JapanNCCE_GC_Pre-Post_ICI_06-2023/spaceranger_outs/NCCE_"
        ct_path = "/maiziezhou_lab3/manfeifei/0Projects/ST_CNV/CT_annotation/JapanNCCE/JapanNCCE_finalCT"
        dir_input = os.path.join(datapath + slice_name, "outs")
        adata = sc.read_visium(path=dir_input)

